# ============================================================
# .env.example  —  Copia a .env y rellena. .env NUNCA va a Git.
#   cp .env.example .env
# ============================================================

# ---------- Base de datos (PostgreSQL + pgvector) ----------
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_dev_pwd
POSTGRES_DB=rag
# La APP (FastAPI async) usa el driver asyncpg:
DATABASE_URL=postgresql+asyncpg://rag:rag_dev_pwd@localhost:5432/rag
# Alembic corre en modo síncrono y usa psycopg:
ALEMBIC_DATABASE_URL=postgresql+psycopg://rag:rag_dev_pwd@localhost:5432/rag
# (Dentro de docker-compose, el host pasa a ser "db" en lugar de localhost; ver docker-compose.yml)

# ---------- Identidad (MVP V1-V3) ----------
# En el MVP no hay login real: la identidad viaja en el header X-User-Id.
# Este es el usuario por defecto para desarrollo. El login real llega en V4.
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# ---------- LLM (interfaz intercambiable) ----------
# Proveedor activo: anthropic | local
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# IDs reales vigentes (ene-2026). Sonnet = buen balance costo/calidad para tesis.
# Opus (claude-opus-4-8) para máxima calidad; Haiku para lo más barato/rápido.
LLM_MODEL=claude-sonnet-4-6
LLM_MODEL_FALLBACK=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1
# Modo local offline (futuro): Qwen2.5 / Llama 3.x vía servidor OpenAI-compatible (ollama, vLLM)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b-instruct

# ---------- Embeddings (ingesta y consulta) ----------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu            # cpu | cuda | mps
EMBEDDING_DIM=1024             # BGE-m3 = 1024
EMBEDDING_BATCH_SIZE=16

# ---------- Reranker (cross-encoder) ----------
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_TOP_N=8               # candidatos que pasan al LLM tras el rerank

# ---------- Recuperación híbrida ----------
RETRIEVAL_TOP_K_VECTOR=30
RETRIEVAL_TOP_K_BM25=30
RRF_K=60                       # constante de Reciprocal Rank Fusion
HNSW_M=16
HNSW_EF_SEARCH=100             # recall del índice HNSW (mayor = más recall, algo más lento)

# ---------- Verificación de fidelidad EN RUNTIME (groundedness) ----------
# OJO: esto NO es el umbral de evaluación. Es el umbral del verificador en vivo:
# si la respuesta cae por debajo, se degrada a "no encontrado en el documento".
# El gate de EVALUACIÓN (RAGAS faithfulness >= 0.85) es algo distinto (ver docs/PLAN.md).
GROUNDEDNESS_THRESHOLD=0.6

# ---------- Voz LOCAL (V3) ----------
PIPER_BINARY=/usr/local/bin/piper
PIPER_VOICE_PATH=/models/voices/es_ES-davefx-medium.onnx
PIPER_VOICE_CONFIG=/models/voices/es_ES-davefx-medium.onnx.json
WHISPER_MODEL=base             # tiny | base | small | medium | large-v3
WHISPER_MODEL_PATH=/models/whisper
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---------- Rutas de modelos, datos y caches ----------
MODELS_DIR=./models
HF_HOME=./models/.hf_cache      # cache de Hugging Face fuera de git
DATA_DIR=./data
UPLOADS_DIR=./data/uploads
TTS_CACHE_DIR=./data/tts_cache

# ---------- Aplicación / seguridad ----------
APP_ENV=development            # development | production
SECRET_KEY=cambia-esto-por-un-valor-aleatorio-largo
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=50

# ---------- Privacidad / retención ----------
DATA_RETENTION_DAYS=365        # purga automática de uploads y derivados
ANONYMIZE_LOGS=true            # no registrar el texto íntegro de los documentos

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
